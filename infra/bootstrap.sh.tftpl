#!/bin/bash
set -euo pipefail
dnf install -y nginx python3 curl tar gzip unzip awscli-2
id tictactest >/dev/null 2>&1 || useradd --system --home /opt/tictactest --shell /sbin/nologin tictactest
install -d -m 755 /opt/tictactest/tools /opt/tictactest/releases /opt/tictactest/bootstrap
printf '%s' '${installer}' | base64 -d > /opt/tictactest/bootstrap/install-tools.sh
printf '%s' '${versions}' | base64 -d > /opt/tictactest/bootstrap/versions.env
bash /opt/tictactest/bootstrap/install-tools.sh /opt/tictactest/tools
printf '%s' '${unit}' | base64 -d > /etc/systemd/system/tictactest.service
printf '%s' '${deployer}' | base64 -d > /usr/local/sbin/tictactest-deploy
chmod 750 /usr/local/sbin/tictactest-deploy
# Replace the distribution default server to avoid duplicate default_server entries.
cat > /etc/nginx/nginx.conf <<'NGINX'
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log;
pid /run/nginx.pid;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    include /etc/nginx/conf.d/*.conf;
}
NGINX
printf '%s' '${nginx}' | base64 -d > /etc/nginx/conf.d/tictactest.conf
nginx -t
systemctl daemon-reload
systemctl enable tictactest nginx amazon-ssm-agent
systemctl restart nginx amazon-ssm-agent
# No application download here: the first deployment populates current/game.jar.
